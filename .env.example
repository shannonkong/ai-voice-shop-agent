# Copy to .env and fill in. Never commit .env.

# ---- LLM (swappable: openai | anthropic | google | bedrock | ollama) ----
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.2
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
AWS_REGION=us-east-1
OLLAMA_BASE_URL=http://localhost:11434

# ---- Embeddings + vector store (Phase 2) ----
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
VECTOR_DB=faiss                  # faiss | chroma
INDEX_DIR=data/index
PRODUCTS_PARQUET=data/processed/products.parquet

# ---- Web search via MCP (Phase 2) ----
WEB_SEARCH_PROVIDER=brave        # brave | serper
BRAVE_API_KEY=
SERPER_API_KEY=
WEB_CACHE_TTL_SECONDS=180
WEB_RATE_LIMIT_PER_MIN=20
WEB_ALLOWED_DOMAINS=amazon.com,walmart.com,target.com,homedepot.com

# ---- MCP server ----
MCP_TRANSPORT=stdio              # stdio | http
MCP_HTTP_PORT=8765

# ---- Voice (Phase 4) ----
ASR_MODEL=base.en                # whisper size, or "openai" for the hosted API
TTS_PROVIDER=openai              # openai | polly | elevenlabs | coqui
TTS_VOICE=alloy

# ---- Logging ----
LOG_DIR=logs
LOG_PROMPTS=true
